<script>
// =============================================================================
// Wonder World — script.js
// Handles: theme switching, ambient effects, screen navigation, and the
// image editor's communication with the FastAPI + OpenCV backend.
// =============================================================================

const API_BASE = window.WONDER_API_BASE || "http://127.0.0.1:8000";

// ----------------------------- THEME ----------------------------------------
const body = document.body;
const themeToggle = document.getElementById("theme-toggle");
const themeIcon = themeToggle.querySelector(".theme-toggle__icon");

function applyTheme(theme) {
  body.setAttribute("data-theme", theme);
  themeIcon.textContent = theme === "light" ? "☀️" : "🌙";
  localStorage.setItem("wonder-theme", theme);
}
(function initTheme() {
  const saved = localStorage.getItem("wonder-theme");
  const preferred = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  applyTheme(preferred);
})();
themeToggle.addEventListener("click", () => {
  const next = body.getAttribute("data-theme") === "light" ? "dark" : "light";
  applyTheme(next);
});

// ----------------------------- STARS + PARTICLES -----------------------------
function seedStars(container, count) {
  if (!container || container.dataset.seeded) return;
  container.dataset.seeded = "true";
  for (let i = 0; i < count; i++) {
    const star = document.createElement("div");
    star.className = "star";
    star.style.left = Math.random() * 100 + "%";
    star.style.top = Math.random() * 70 + "%";
    star.style.animationDelay = (Math.random() * 3).toFixed(2) + "s";
    star.style.width = star.style.height = (Math.random() * 2 + 1.5).toFixed(1) + "px";
    container.appendChild(star);
  }
}
function seedParticles(container, count) {
  if (!container || container.dataset.seeded) return;
  container.dataset.seeded = "true";
  const colors = ["--accent-1", "--accent-2", "--accent-3", "--accent-4", "--accent-5"];
  for (let i = 0; i < count; i++) {
    const p = document.createElement("div");
    p.className = "glow-particle";
    const size = Math.random() * 10 + 6;
    p.style.width = p.style.height = size + "px";
    p.style.left = Math.random() * 100 + "%";
    p.style.bottom = "-5%";
    p.style.background = `radial-gradient(circle, var(${colors[i % colors.length]}), transparent 70%)`;
    p.style.animationDuration = (Math.random() * 14 + 12) + "s";
    p.style.animationDelay = (Math.random() * 10) + "s";
    container.appendChild(p);
  }
}
seedStars(document.getElementById("stars-home"), 60);
seedStars(document.getElementById("stars-main"), 40);
seedParticles(document.getElementById("particles-home"), 16);
seedParticles(document.getElementById("particles-main"), 10);

// ----------------------------- CURSOR SPARKLE TRAIL ---------------------------
const sparkleLayer = document.getElementById("sparkle-layer");
const sparkleColors = ["#ff8a65", "#ffd76a", "#7ee0c3", "#8e7cff", "#ff6fa5", "#6fd3ff"];
let lastSparkle = 0;
function spawnSparkle(x, y) {
  const now = performance.now();
  if (now - lastSparkle < 40) return; // throttle for perf
  lastSparkle = now;
  const s = document.createElement("div");
  s.className = "sparkle";
  s.style.left = x + "px";
  s.style.top = y + "px";
  s.style.background = sparkleColors[Math.floor(Math.random() * sparkleColors.length)];
  s.style.boxShadow = `0 0 8px 2px ${s.style.background}`;
  sparkleLayer.appendChild(s);
  setTimeout(() => s.remove(), 720);
}
window.addEventListener("pointermove", (e) => spawnSparkle(e.clientX, e.clientY));

// ----------------------------- NAVIGATION -------------------------------------
const screens = {
  home: document.getElementById("screen-home"),
  main: document.getElementById("screen-main"),
  editor: document.getElementById("screen-editor"),
};
function goTo(name) {
  Object.values(screens).forEach((s) => s.classList.remove("screen--active"));
  screens[name].classList.add("screen--active");
  window.scrollTo({ top: 0, behavior: "smooth" });
}
document.querySelectorAll("[data-nav]").forEach((el) => {
  el.addEventListener("click", () => goTo(el.dataset.nav));
});
document.getElementById("get-started-btn").addEventListener("click", () => goTo("main"));

// ----------------------------- TOAST -------------------------------------------
const toastEl = document.getElementById("toast");
let toastTimer = null;
function showToast(message, isError = false) {
  toastEl.textContent = message;
  toastEl.classList.toggle("toast--error", isError);
  toastEl.classList.add("toast--show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toastEl.classList.remove("toast--show"), 3200);
}

// ============================================================================
// IMAGE EDITOR
// ============================================================================
const els = {
  dropzone: document.getElementById("dropzone"),
  fileInput: document.getElementById("file-input"),
  uploadZone: document.getElementById("upload-zone"),
  workspace: document.getElementById("editor-workspace"),
  filename: document.getElementById("editor-filename"),
  dims: document.getElementById("editor-dims"),
  previewImg: document.getElementById("preview-img"),
  previewFrame: document.getElementById("preview-frame"),
  previewStage: document.getElementById("preview-stage"),
  previewLoading: document.getElementById("preview-loading"),
  downloadBtn: document.getElementById("download-btn"),
  downloadFormat: document.getElementById("download-format"),
  resetCurrentBtn: document.getElementById("reset-current-btn"),
  resetAllBtn: document.getElementById("reset-all-btn"),
  viewEdited: document.getElementById("view-edited"),
  viewOriginal: document.getElementById("view-original"),
  zoomIn: document.getElementById("zoom-in"),
  zoomOut: document.getElementById("zoom-out"),
  zoomFit: document.getElementById("zoom-fit"),
  zoomReset: document.getElementById("zoom-reset"),
  zoomLevel: document.getElementById("zoom-level"),
};

const state = {
  sessionId: null,
  originalDataUrl: null,
  currentDataUrl: null,
  zoom: 1,
  viewingOriginal: false,
};

// ---- Drag & drop / upload -----------------------------------------------
["dragenter", "dragover"].forEach((evt) =>
  els.dropzone.addEventListener(evt, (e) => {
    e.preventDefault();
    els.dropzone.classList.add("dragover");
  })
);
["dragleave", "drop"].forEach((evt) =>
  els.dropzone.addEventListener(evt, (e) => {
    e.preventDefault();
    els.dropzone.classList.remove("dragover");
  })
);
els.dropzone.addEventListener("drop", (e) => {
  const file = e.dataTransfer.files && e.dataTransfer.files[0];
  if (file) handleUpload(file);
});
els.fileInput.addEventListener("change", (e) => {
  const file = e.target.files[0];
  if (file) handleUpload(file);
});

function validateFile(file) {
  const okTypes = ["image/jpeg", "image/jpg", "image/png"];
  if (!okTypes.includes(file.type)) {
    showToast("Please upload a JPG, JPEG, or PNG image.", true);
    return false;
  }
  return true;
}

async function handleUpload(file) {
  if (!validateFile(file)) return;
  const formData = new FormData();
  formData.append("file", file);

  setLoading(true);
  try {
    const res = await fetch(`${API_BASE}/upload`, { method: "POST", body: formData });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || "Upload failed.");

    state.sessionId = data.session_id;
    state.originalDataUrl = data.image;
    state.currentDataUrl = data.image;
    state.viewingOriginal = false;

    els.filename.textContent = data.filename;
    els.dims.textContent = `${data.width} × ${data.height}px`;
    els.previewImg.src = data.image;

    els.uploadZone.hidden = true;
    els.workspace.hidden = false;
    els.downloadBtn.disabled = false;
    els.resetCurrentBtn.disabled = false;
    els.resetAllBtn.disabled = false;

    resetZoom();
    showToast("Image loaded — start editing! ✨");
  } catch (err) {
    showToast(err.message || "Something went wrong uploading the image.", true);
  } finally {
    setLoading(false);
  }
}

function setLoading(isLoading) {
  els.previewLoading.hidden = !isLoading;
  els.previewImg.style.opacity = isLoading ? "0.4" : "1";
}

// ---- Tool tabs -------------------------------------------------------------
document.querySelectorAll(".tool-tab").forEach((tab) => {
  tab.addEventListener("click", () => {
    document.querySelectorAll(".tool-tab").forEach((t) => t.classList.remove("tool-tab--active"));
    document.querySelectorAll(".tool-pane").forEach((p) => p.classList.remove("tool-pane--active"));
    tab.classList.add("tool-tab--active");
    document.querySelector(`.tool-pane[data-pane="${tab.dataset.tab}"]`).classList.add("tool-pane--active");
  });
});

// ---- Live slider labels -----------------------------------------------------
const liveLabel = (sliderId, labelId, suffix = "") => {
  const slider = document.getElementById(sliderId);
  const label = document.getElementById(labelId);
  if (!slider || !label) return;
  slider.addEventListener("input", () => (label.textContent = slider.value + suffix));
};
liveLabel("brightness-slider", "brightness-val");
liveLabel("contrast-slider", "contrast-val");
liveLabel("blur-slider", "blur-val");
liveLabel("gblur-slider", "gblur-val");
liveLabel("mblur-slider", "mblur-val");
liveLabel("thresh-slider", "thresh-val");

// Debounced auto-apply for single sliders (brightness/contrast/threshold)
function debounce(fn, delay) {
  let t;
  return (...args) => {
    clearTimeout(t);
    t = setTimeout(() => fn(...args), delay);
  };
}
const debouncedApply = debounce((op, params) => applyOperation(op, params), 260);

document.getElementById("brightness-slider").addEventListener("input", (e) =>
  debouncedApply("brightness", { value: Number(e.target.value) })
);
document.getElementById("contrast-slider").addEventListener("input", (e) =>
  debouncedApply("contrast", { value: Number(e.target.value) })
);
document.getElementById("thresh-slider").addEventListener("input", (e) =>
  debouncedApply("binary_threshold", { thresh: Number(e.target.value) })
);

// ---- Tool buttons ------------------------------------------------------------
document.querySelectorAll("[data-op]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const op = btn.dataset.op;
    if (op === "original") return showOriginalPreview();
    if (op === "__reset_current") return resetCurrent();
    handleToolClick(op);
  });
});

function handleToolClick(op) {
  switch (op) {
    case "resize": {
      const w = document.getElementById("resize-w").value;
      const h = document.getElementById("resize-h").value;
      if (!w && !h) return showToast("Enter a width or height first.", true);
      return applyOperation("resize", { width: w || null, height: h || null });
    }
    case "rgb_adjust": {
      const r = Number(document.getElementById("r-slider").value);
      const g = Number(document.getElementById("g-slider").value);
      const b = Number(document.getElementById("b-slider").value);
      return applyOperation("rgb_adjust", { r, g, b });
    }
    case "blur":
      return applyOperation("blur", { ksize: Number(document.getElementById("blur-slider").value) });
    case "gaussian_blur":
      return applyOperation("gaussian_blur", { ksize: Number(document.getElementById("gblur-slider").value) });
    case "median_blur":
      return applyOperation("median_blur", { ksize: Number(document.getElementById("mblur-slider").value) });
    case "binary_threshold":
      return applyOperation("binary_threshold", { thresh: Number(document.getElementById("thresh-slider").value) });
    case "adaptive_threshold":
      return applyOperation("adaptive_threshold", { block_size: 11, c: 2 });
    case "canny": {
      const t1 = Number(document.getElementById("canny-t1").value);
      const t2 = Number(document.getElementById("canny-t2").value);
      return applyOperation("canny", { t1, t2 });
    }
    default:
      return applyOperation(op, {});
  }
}

async function applyOperation(operation, params) {
  if (!state.sessionId) return showToast("Upload an image first.", true);
  setLoading(true);
  try {
    const res = await fetch(`${API_BASE}/process`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session_id: state.sessionId, operation, params }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || "Processing failed.");

    state.currentDataUrl = data.image;
    state.viewingOriginal = false;
    setViewToggle(false);
    els.previewImg.src = data.image;
    els.dims.textContent = `${data.width} × ${data.height}px`;
  } catch (err) {
    showToast(err.message || "That edit couldn't be applied.", true);
  } finally {
    setLoading(false);
  }
}

async function resetCurrent() {
  return runReset("current", "Last edit undone.");
}
async function resetAll() {
  return runReset("all", "Image reset to original.");
}
async function runReset(mode, successMessage) {
  if (!state.sessionId) return;
  setLoading(true);
  try {
    const formData = new FormData();
    formData.append("session_id", state.sessionId);
    formData.append("mode", mode);
    const res = await fetch(`${API_BASE}/reset`, { method: "POST", body: formData });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || "Reset failed.");

    state.currentDataUrl = data.image;
    state.viewingOriginal = false;
    setViewToggle(false);
    els.previewImg.src = data.image;
    els.dims.textContent = `${data.width} × ${data.height}px`;
    showToast(successMessage);
  } catch (err) {
    showToast(err.message || "Could not reset the image.", true);
  } finally {
    setLoading(false);
  }
}
els.resetAllBtn.addEventListener("click", resetAll);
els.resetCurrentBtn.addEventListener("click", resetCurrent);

function showOriginalPreview() {
  if (!state.originalDataUrl) return;
  els.previewImg.src = state.originalDataUrl;
  setViewToggle(true);
}

// ---- Original / Edited compare toggle ----------------------------------------
function setViewToggle(showingOriginal) {
  state.viewingOriginal = showingOriginal;
  els.viewOriginal.classList.toggle("compare-toggle__btn--active", showingOriginal);
  els.viewEdited.classList.toggle("compare-toggle__btn--active", !showingOriginal);
}
els.viewOriginal.addEventListener("click", () => {
  if (!state.originalDataUrl) return;
  els.previewImg.src = state.originalDataUrl;
  setViewToggle(true);
});
els.viewEdited.addEventListener("click", () => {
  if (!state.currentDataUrl) return;
  els.previewImg.src = state.currentDataUrl;
  setViewToggle(false);
});

// ---- Download ------------------------------------------------------------------
els.downloadBtn.addEventListener("click", () => {
  if (!state.sessionId) return;
  const fmt = els.downloadFormat.value;
  const url = `${API_BASE}/download?session_id=${state.sessionId}&format=${fmt}`;
  const a = document.createElement("a");
  a.href = url;
  a.download = "";
  document.body.appendChild(a);
  a.click();
  a.remove();
});

// ---- Zoom controls ---------------------------------------------------------
function applyZoom() {
  els.previewFrame.style.transform = `scale(${state.zoom})`;
  els.zoomLevel.textContent = Math.round(state.zoom * 100) + "%";
}
function resetZoom() {
  state.zoom = 1;
  applyZoom();
}
els.zoomIn.addEventListener("click", () => {
  state.zoom = Math.min(3, state.zoom + 0.2);
  applyZoom();
});
els.zoomOut.addEventListener("click", () => {
  state.zoom = Math.max(0.2, state.zoom - 0.2);
  applyZoom();
});
els.zoomReset.addEventListener("click", resetZoom);
els.zoomFit.addEventListener("click", () => {
  state.zoom = 1;
  applyZoom();
  els.previewStage.scrollTo({ top: 0, left: 0, behavior: "smooth" });
});

</script>
</body>
</html>
