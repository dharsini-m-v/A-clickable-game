  transition: transform var(--transition-fast), opacity var(--transition-fast);
  z-index: 1000;
  max-width: 90vw;
  text-align: center;
}
.toast--error { border-color: #ff6b6b; }
.toast.toast--show { opacity: 1; transform: translateX(-50%) translateY(0); }

